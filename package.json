{
  "name": "jovana-marceta-portfolio",
  "version": "2.0.0",
  "private": true,
  "description": "Portfolio of Jovana Marčeta, Fullstack Software Engineer. React + Vite frontend, Node backend (Netlify Functions + Turso), blog admin and meeting booking.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "node --watch --disable-warning=ExperimentalWarning server/server.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "node --disable-warning=ExperimentalWarning server/server.mjs",
    "preview": "vite build && npm start"
  },
  "dependencies": {
    "@libsql/client": "^0.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
