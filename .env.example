# Copy to .env and fill in.

# Password for /admin (use something long)
ADMIN_PASSWORD=change-me-to-a-long-password

# Port of the API server. In development Vite runs on 5173 and proxies to it.
# In production (npm start) this is the port of the whole site.
PORT=3000

# Public address of the site, used in calendar invites, RSS and links
SITE_URL=http://localhost:5173

# Where the SQLite database lives (point this at a persistent disk in production)
DATA_DIR=./data
NODE_ENV=development

# Optional: e-mail notification for every new booking via https://resend.com
# RESEND_API_KEY=re_...
# NOTIFY_EMAIL=jmarcetadev@gmail.com
# NOTIFY_FROM=Portfolio <bookings@your-domain.com>
