# Copy to .env for local development.

# Password for /admin
ADMIN_PASSWORD=123

# Port of the local API server (Vite runs on 5173 and proxies to it)
PORT=3000

# Public address of the site, used in calendar invites, RSS and links
SITE_URL=http://localhost:5173

# Local database folder (only used when TURSO_DATABASE_URL is empty)
DATA_DIR=./data

# Production database on Turso. Leave empty locally to use the local file.
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=...

# Optional: e-mail notification for every new booking via https://resend.com
# RESEND_API_KEY=re_...
# NOTIFY_EMAIL=jmarcetadev@gmail.com
# NOTIFY_FROM=Portfolio <bookings@your-domain.com>